# このファイルをコピーして .env を作成し、実際の値を入れて使う。
# .env はコミットしない(.gitignoreで除外済み)。
# 以下はローカル開発用のダミー値の例。本番の秘密情報は絶対に入れない。

MYSQL_DATABASE=bonsai
MYSQL_USER=bonsai_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# app(Next.js)コンテナから db コンテナへ接続する際のURL。
# ホスト名は Docker Compose のサービス名 "db" を使う(localhostではない)。
# アプリ実行時はこのユーザー(bonsai_userの権限は bonsai データベースのみ)を使う。
DATABASE_URL="mysql://bonsai_user:change_me@db:3306/bonsai"

# `prisma migrate dev` が一時的に作成・破棄する shadow database 用の接続。
# shadow db作成にはデータベースを作成する権限が必要なため、bonsai_userではなくrootを使う。
# (bonsai_userは最小権限のまま = bonsaiデータベースのみアクセス可能)
# このURLはPrisma CLI(migrate)からのみ使用され、アプリ実行時には使用しない。
SHADOW_DATABASE_URL="mysql://root:change_me_root@db:3306/prisma_shadow"
